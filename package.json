{
  "name": "@audiodn/ai-plugin",
  "version": "1.1.1",
  "description": "AudioDN plugin for Cursor, Claude Code, and Codex: store, play, and preview audio from agents, plus secure upload/playback skills and MCP.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "AudioDN",
    "url": "https://github.com/audiodn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiodn/ai-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/audiodn/ai-plugin/issues"
  },
  "homepage": "https://github.com/audiodn/ai-plugin#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:openapi": "node scripts/audit-openapi.mjs",
    "validate:mcp": "node scripts/audit-mcp.mjs",
    "check:links": "node scripts/check-links.mjs",
    "sync": "node scripts/sync-audiodn-sources.mjs",
    "test": "node --test test/*.test.mjs",
    "ci": "npm run validate && npm run build && npm run validate:openapi && npm run validate:mcp && npm run check:links && npm test",
    "prepublishOnly": "npm run build && npm run validate && npm test"
  },
  "keywords": [
    "audiodn",
    "audio",
    "cursor",
    "claude",
    "openai",
    "codex",
    "mcp",
    "skills",
    "plugin"
  ]
}
